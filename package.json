{
  "name": "folder-viewer",
  "displayName": "Folder Viewer",
  "description": "Explore a folder in the editor view",
  "version": "3.5.0",
  "publisher": "huanent",
  "icon": "resources/logo.png",
  "repository": {
    "url": "https://github.com/huanent/vscode-folder-viewer.git",
    "type": "github"
  },
  "license": "MIT",
  "homepage": "https://github.com/huanent/vscode-folder-viewer",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./out/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "folderViewer.editor",
        "displayName": "Folder Viewer",
        "selector": [
          {
            "filenamePattern": "*.folder-viewer"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "folderViewer.open",
        "title": "Open in Folder Viewer"
      }
    ],
    "keybindings": [
      {
        "command": "folderViewer.open",
        "key": "ctrl+shift+;",
        "mac": "cmd+shift+;"
      },
      {
        "command": "folderViewer.openNewTab",
        "key": "ctrl+t",
        "mac": "cmd+t",
        "when": "activeCustomEditorId == folderViewer.editor && folderViewer.webviewFocus"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "folderViewer.open",
          "group": "navigation@999"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "npm run compile && npm run compile:webview",
    "compile": "tsc -p ./",
    "compile:webview": "vite build",
    "package": "vsce package --no-yarn",
    "publish": "vsce publish --no-yarn"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@types/vscode": "^1.125.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vscode/codicons": "^0.0.45",
    "@vscode/vsce": "^3.9.2",
    "@vitejs/plugin-react": "^6.0.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  },
  "dependencies": {
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  }
}
